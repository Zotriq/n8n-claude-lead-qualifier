        "message": "=*{{ $json.priority }} lead - {{ $json.category }} ({{ $json.score }}/100)*\n*{{ $json.lead_name }}* <{{ $json.lead_email }}> - {{ $json.lead_company }}\nBudget: {{ $json.lead_budget }} | Timeline: {{ $json.lead_timeline }}\nUse case: {{ $json.use_case }}\nSuggested next step: `{{ $json.next_action }}`\nWhy: {{ $json.reasoning }}\n\n>{{ $json.lead_message }}\n\n*Draft reply* - _{{ $json.reply_subject }}_\n```{{ $json.reply_body }}```\nApprove = add to HubSpot *and* email this reply. Decline = discard.",
        "approvalOptions": {
