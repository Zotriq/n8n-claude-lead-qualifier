        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "b1000000-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "jsCode": "// Validate and normalize the incoming webhook payload.\n// Accepts JSON bodies like: { name, email, company, budget, timeline, message, website }\nconst body = $input.first().json.body || $input.first().json;\nconst s = (v) => (typeof v === 'string' ? v.trim() : '');\n\nconst lead = {\n  lead_name: s(body.name),\n  lead_email: s(body.email).toLowerCase(),\n  lead_company: s(body.company),\n  lead_budget: s(body.budget) || 'Not specified',\n  lead_timeline: s(body.timeline) || 'Not specified',\n  lead_message: s(body.message).slice(0, 4000),\n  lead_source: s(body.source) || 'website',\n  received_at: $now.toISO(),\n};\n\nconst errors = [];\nif (!lead.lead_name) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.lead_email)) errors.push('a valid email is required');\nif (lead.lead_message.length < 10) errors.push('message must be at least 10 characters');\n\n// Honeypot: real users never fill the hidden \"website\" field; bots usually do.\nconst honeypot = s(body.website) !== '';\n\nreturn [{ json: { ...lead, is_valid: errors.length === 0, is_bot: honeypot, validation_errors: errors } }];\n"
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
